# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env

# --- LLM API (둘 중 사용하는 것만 채우면 됨) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 로컬 모델 (WSL2 GPU 실험용) ---
# 예: Qwen/Qwen3-8B, LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
LOCAL_MODEL_ID=
HF_TOKEN=

# --- 임베딩 ---
EMBEDDING_MODEL_ID=BAAI/bge-m3

# --- 벡터DB·사실 메모리 저장 경로 ---
CHROMA_DIR=./chroma
FACT_DB_PATH=./data/facts.sqlite

# --- 페르소나 카드 ---
PERSONA_CARD_PATH=./persona/artist_card.yaml

# --- 로깅 ---
LOG_LEVEL=INFO
